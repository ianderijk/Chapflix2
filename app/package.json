{
  "name": "chapflix-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "format": "prettier --write assets eslint.config.js stylelint.config.js ../tests/frontend/*.mjs",
    "lint": "prettier --check assets eslint.config.js stylelint.config.js ../tests/frontend/*.mjs && eslint && stylelint \"assets/**/*.css\"",
    "test": "node --test \"../tests/frontend/*.test.mjs\""
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "eslint": "^9.37.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "stylelint": "^16.25.0",
    "stylelint-config-standard": "^39.0.1"
  }
}
